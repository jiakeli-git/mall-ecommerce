<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mall2.Order.mapper.OrderItemMapper">

    <!--
        ✅ 修正点1：type 改为 OrderItem 实体类的全限定类名
        ✅ 修正点2：修复 product_id 行 w="BIGINT" 的笔误，改为 jdbcType="BIGINT"
    -->
    <resultMap id="BaseResultMap" type="com.mall2.Order.model.OrderItem">
        <id column="id" property="id" jdbcType="BIGINT"/>
        <result column="order_id" property="orderId" jdbcType="BIGINT"/>
        <result column="product_id" property="productId" jdbcType="BIGINT"/>
        <result column="product_name" property="productName" jdbcType="VARCHAR"/>
        <result column="product_price" property="productPrice" jdbcType="DECIMAL"/>
        <result column="quantity" property="quantity" jdbcType="INTEGER"/>
        <result column="total_price" property="totalPrice" jdbcType="DECIMAL"/>
    </resultMap>

    <sql id="Base_Column_List">
        id,
        order_id,
        product_id,
        product_name,
        product_price,
        quantity,
        total_price
    </sql>

    <!-- 批量插入订单项 -->
    <insert id="batchInsert">
        INSERT INTO t_order_item (order_id, product_id, product_name, product_price, quantity, total_price)
        VALUES
        <foreach collection="list" item="item" separator=",">
            (
            #{item.orderId},
            #{item.productId},
            #{item.productName},
            #{item.productPrice},
            #{item.quantity},
            #{item.totalPrice}
            )
        </foreach>
    </insert>

    <!-- 根据订单ID查询所有明细 -->
    <select id="selectByOrderId" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM t_order_item
        WHERE order_id = #{orderId}
    </select>

</mapper>